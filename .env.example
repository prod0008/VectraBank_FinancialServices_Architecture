# AWS Credentials (Replace with your own or Udacity lab credentials)
# NEVER commit real credentials to this file. Use .env for that.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here
AWS_DEFAULT_REGION=us-east-1

# VectraBank Resource IDs (placeholders for architecture planning)
MARKET_DATA_KB_ID=kb-market-data-placeholder
COMPLIANCE_KB_ID=kb-compliance-placeholder
RISK_ASSESSMENT_KB_ID=kb-risk-placeholder
STATE_TABLE_NAME=vectrabank-agent-state
AUDIT_TABLE_NAME=vectrabank-audit-logs
